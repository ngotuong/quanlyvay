# Only the Next.js workspace and root package-manager metadata are needed by Vercel.
/apps/google-sync/
/packages/
/supabase/
/docs/
/scripts/
/apps/web/test/
/apps/web/playwright.config.ts

/AGENTS.md
/PROJECT_CONTEXT.md
/README.md

# Defense in depth for local-only identifiers and build caches.
**/.clasp.json
**/*.tsbuildinfo

# Git ignore is not a substitute for Vercel upload exclusions.
/.backups/
/.cache/
**/.backups/
**/.cache/
**/.tmp/

# Test artifacts and local credentials must never enter deployment payloads.
**/test-results/
**/playwright-report/
**/coverage/
**/*.log
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
/.tmp/
/.c55-remote-head/

# Secret-scan disposition metadata is not runtime source.
/.gitleaksignore
